{
  "name": "keren-wangombe-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Keren Wang'ombe — Operations and Data portfolios (shared design system, two deployable sites)",
  "scripts": {
    "dev": "cd sites/operations && next dev",
    "dev:ops": "cd sites/operations && next dev",
    "dev:data": "cd sites/data && next dev",
    "build": "npm run build:ops && npm run build:data",
    "build:ops": "cd sites/operations && next build",
    "build:data": "cd sites/data && next build",
    "start:ops": "cd sites/operations && next start",
    "start:data": "cd sites/data && next start",
    "lint:ops": "cd sites/operations && next lint",
    "lint:data": "cd sites/data && next lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "adm-zip": "^0.5.18",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "mammoth": "^1.12.0",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
